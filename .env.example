# Agent Knowledge Base — environment variables
# Copy to .env and fill in. .env is gitignored; never commit it.
#
# Embedding provider (kb/dense.py). Required for dense retrieval + hybrid.
# Gemini Embedding API key — see https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Voyage (alternative embedding provider, issue #3). Wired into kb/dense.py.
# voyage-3 (text, 1024-dim) verified working; voyage-multimodal-3.5 is NOT
# supported on this account (see docs/research/media-embeddings.md).
VOYAGE_API_KEY=your_voyage_api_key_here

# Which embedding provider kb/dense.py uses. Default "gemini"; set "voyage" to use
# the Voyage index (separate DB data/kb/dense-voyage.db). Also selectable per-run
# via `--provider gemini|voyage` on the kb.dense CLI.
# KB_EMBED_PROVIDER=gemini
