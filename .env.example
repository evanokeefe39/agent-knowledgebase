# Agent Knowledge Base — environment variables
# Copy to .env and fill in. .env is gitignored; never commit it.
#
# Embedding provider (kb/dense.py). Required for dense retrieval + hybrid.
# Gemini Embedding API key — see https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Voyage multimodal-3.5 (candidate under evaluation — see issue #3)
# If set, kb/dense.py can be pointed at the Voyage model instead of Gemini.
# VOYAGE_API_KEY=your_voyage_api_key_here
