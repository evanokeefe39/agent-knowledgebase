# Agent Knowledge Base — environment variables
# Copy to .env and fill in. .env is gitignored; never commit it.
#
# Embedding provider (kb/dense.py). Required for dense retrieval + hybrid.
# Gemini Embedding API key — see https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Voyage multimodal-3.5 — candidate under evaluation, NOT yet wired
# (see issue #3). kb/dense.py currently hardcodes gemini-embedding-001 and reads
# only GEMINI_API_KEY; setting this key does nothing until that work lands.
# VOYAGE_API_KEY=your_voyage_api_key_here
